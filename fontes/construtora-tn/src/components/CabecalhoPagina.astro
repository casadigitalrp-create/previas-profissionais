---
interface Props {
  rotulo: string;
  titulo: string;
  texto?: string;
}

const { rotulo, titulo, texto } = Astro.props;
---

<section class="regua border-b border-borda">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-tijolo">{rotulo}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold md:text-5xl">{titulo}</h1>
    {texto && <p class="mt-5 max-w-2xl text-lg text-suave">{texto}</p>}
    <slot />
  </div>
</section>
