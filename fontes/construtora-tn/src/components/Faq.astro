---
import { faq } from "../data/site";
---

<div class="divide-y divide-borda rounded-xl border border-borda bg-superficie">
  {
    faq.map((item) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
          {item.p}
          <span class="text-2xl leading-none text-tijolo transition group-open:rotate-45" aria-hidden="true">
            +
          </span>
        </summary>
        <p class="mt-3 text-suave">{item.r}</p>
      </details>
    ))
  }
</div>
