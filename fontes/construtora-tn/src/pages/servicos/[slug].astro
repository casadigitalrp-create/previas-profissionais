---
import CabecalhoPagina from "../../components/CabecalhoPagina.astro";
import Cta from "../../components/Cta.astro";
import Ilustracao from "../../components/Ilustracao.astro";
import ObraCard from "../../components/ObraCard.astro";
import { obras } from "../../data/obras";
import { type Servico, servicos } from "../../data/servicos";
import { etapas, url } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return servicos.map((servico) => ({ params: { slug: servico.slug }, props: { servico } }));
}

interface Props {
  servico: Servico;
}

const { servico } = Astro.props;
const relacionadas = obras.filter((o) => o.desenho === servico.desenho).slice(0, 3);
---

<Layout titulo={servico.titulo} descricao={servico.resumo}>
  <CabecalhoPagina rotulo="Serviço" titulo={servico.titulo} texto={servico.resumo}>
    <nav aria-label="Caminho" class="mt-6 text-sm text-suave">
      <a href={url("servicos/")} class="hover:underline">Serviços</a> / <span>{servico.titulo}</span>
    </nav>
  </CabecalhoPagina>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pt-20 md:grid-cols-2">
    <div class="reveal">
      <h2 class="text-2xl font-extrabold">Para quem é</h2>
      <p class="mt-3 text-lg text-suave">{servico.paraQuem}</p>
      <h2 class="mt-10 text-2xl font-extrabold">O que está incluído</h2>
      <ul class="mt-4 space-y-3">
        {
          servico.inclui.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-tijolo text-xs text-tijolo-texto" aria-hidden="true">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-suave">Escopo ilustrativo, a confirmar.</p>
    </div>
    <div class="reveal overflow-hidden rounded-2xl border border-borda">
      <Ilustracao desenho={servico.desenho} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20" aria-labelledby="passos">
    <h2 id="passos" class="reveal text-2xl font-extrabold">Como funciona</h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-5">
      {
        etapas.map((e, i) => (
          <li class="reveal rounded-xl border border-borda bg-superficie p-5">
            <p class="font-display text-2xl font-extrabold text-tijolo">{i + 1}</p>
            <h3 class="mt-1 font-bold">{e.titulo}</h3>
            <p class="mt-1 text-sm text-suave">{e.texto}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    relacionadas.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pt-20" aria-labelledby="exemplos">
        <h2 id="exemplos" class="reveal text-2xl font-extrabold">
          Obras deste tipo
        </h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relacionadas.map((o) => (
            <ObraCard obra={o} />
          ))}
        </div>
      </section>
    )
  }

  <Cta titulo={`Quer um orçamento de ${servico.titulo.toLowerCase()}?`} />
</Layout>
