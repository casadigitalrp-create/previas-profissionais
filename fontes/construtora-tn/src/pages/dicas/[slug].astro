---
import Cta from "../../components/Cta.astro";
import { type Dica, dicas } from "../../data/dicas";
import { url } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return dicas.map((dica) => ({ params: { slug: dica.slug }, props: { dica } }));
}

interface Props {
  dica: Dica;
}

const { dica } = Astro.props;
const outras = dicas.filter((d) => d.slug !== dica.slug);
---

<Layout titulo={dica.titulo} descricao={dica.resumo}>
  <article class="mx-auto max-w-3xl px-4 pt-14">
    <nav aria-label="Caminho" class="text-sm text-suave">
      <a href={url("dicas/")} class="hover:underline">Dicas</a> / <span>Artigo</span>
    </nav>
    <h1 class="mt-5 text-4xl font-extrabold md:text-5xl">{dica.titulo}</h1>
    <p class="mt-4 text-lg text-suave">{dica.resumo}</p>
    <p class="mt-2 text-sm text-suave">Leitura de {dica.leitura} · Texto de exemplo, aguardando revisão técnica.</p>
    <div class="mt-10 space-y-6 text-lg leading-relaxed">
      {
        dica.blocos.map((b) => (
          <>
            {b.subtitulo && <h2 class="pt-4 text-2xl font-extrabold">{b.subtitulo}</h2>}
            <p>{b.texto}</p>
          </>
        ))
      }
    </div>
  </article>

  <aside class="mx-auto max-w-3xl px-4 pt-16" aria-labelledby="leia-tambem">
    <h2 id="leia-tambem" class="text-xl font-bold">Leia também</h2>
    <ul class="mt-4 space-y-2">
      {
        outras.map((d) => (
          <li>
            <a href={url(`dicas/${d.slug}/`)} class="font-medium text-tijolo hover:underline">
              {d.titulo}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <Cta />
</Layout>
