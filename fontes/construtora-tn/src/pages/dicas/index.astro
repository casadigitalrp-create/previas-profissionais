---
import CabecalhoPagina from "../../components/CabecalhoPagina.astro";
import Cta from "../../components/Cta.astro";
import { dicas } from "../../data/dicas";
import { url } from "../../data/site";
import Layout from "../../layouts/Layout.astro";
---

<Layout titulo="Dicas" descricao="Dicas da Construtora TN para construir e reformar com mais segurança.">
  <CabecalhoPagina
    rotulo="Dicas"
    titulo="Informação antes de construir."
    texto="Explicações diretas para você decidir melhor, mesmo que ainda não vá contratar ninguém."
  />

  <section class="mx-auto grid max-w-6xl gap-5 px-4 pt-16 md:grid-cols-3">
    {
      dicas.map((d) => (
        <article class="reveal relative flex flex-col rounded-xl border border-borda bg-superficie p-6 transition hover:border-tijolo">
          <p class="text-sm text-suave">Leitura de {d.leitura}</p>
          <h2 class="mt-2 text-xl font-bold">
            <a href={url(`dicas/${d.slug}/`)} class="after:absolute after:inset-0">
              {d.titulo}
            </a>
          </h2>
          <p class="mt-3 text-suave">{d.resumo}</p>
          <p class="mt-auto pt-5 font-semibold text-tijolo">Ler →</p>
        </article>
      ))
    }
  </section>

  <Cta />
</Layout>
