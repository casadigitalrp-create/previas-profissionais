---
import "../styles/global.css";
import { menu, rodapeLinks, site, url, whatsappLink } from "../data/site";

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const tituloCompleto = `${titulo} | ${site.nome} (prévia)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const atual = Astro.url.pathname;
const ativo = (href: string) => {
  const alvo = url(href);
  return href === "" ? atual === alvo : atual.startsWith(alvo);
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#23272e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-tijolo focus:px-4 focus:py-2 focus:font-semibold focus:text-tijolo-texto"
      >Pular para o conteúdo</a
    >

    <div class="bg-tijolo px-4 py-2 text-center text-sm font-medium text-tijolo-texto" role="note">
      Prévia demonstrativa para aprovação. Textos, obras, números e contatos são ilustrativos.
    </div>

    <header class="sticky top-0 z-50 border-b border-borda bg-fundo/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
        <a href={url()} class="flex items-center gap-2.5 font-display text-lg font-extrabold">
          <span
            class="grid size-9 place-items-center rounded-md bg-marca text-sm font-black tracking-tight text-marca-texto"
            aria-hidden="true">TN</span
          >
          Construtora TN
        </a>

        <nav aria-label="Principal" class="hidden lg:block">
          <ul class="flex items-center gap-1">
            {
              menu.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={ativo(item.href) ? "page" : undefined}
                    class="rounded-md px-3 py-2 text-sm font-medium text-suave hover:text-texto aria-[current=page]:text-tijolo"
                  >
                    {item.rotulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={url("orcamento/")}
            class="hidden rounded-md bg-tijolo px-4 py-2 text-sm font-semibold text-tijolo-texto hover:brightness-110 sm:inline-block"
            >Pedir orçamento</a
          >
          <details class="relative lg:hidden" id="menu-movel">
            <summary
              class="grid size-10 cursor-pointer list-none place-items-center rounded-md border border-borda [&::-webkit-details-marker]:hidden"
            >
              <span class="sr-only">Abrir menu</span>
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
            </summary>
            <nav
              aria-label="Menu"
              class="absolute right-0 mt-2 w-56 rounded-lg border border-borda bg-superficie p-2 shadow-xl"
            >
              <ul>
                {
                  [...menu, ...rodapeLinks].map((item) => (
                    <li>
                      <a
                        href={url(item.href)}
                        aria-current={ativo(item.href) ? "page" : undefined}
                        class="block rounded-md px-3 py-2.5 hover:bg-superficie-2 aria-[current=page]:font-semibold aria-[current=page]:text-tijolo"
                      >
                        {item.rotulo}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-marca text-marca-texto">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-3">
        <div>
          <p class="font-display text-xl font-extrabold">Construtora TN</p>
          <p class="mt-3 max-w-xs text-sm opacity-80">{site.slogan}</p>
          <p class="mt-4 text-sm opacity-80">
            Responsável técnico: {site.responsavel}<br />{site.crea}
          </p>
        </div>
        <nav aria-label="Rodapé">
          <p class="text-sm font-semibold uppercase tracking-widest opacity-60">Páginas</p>
          <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
            {
              [...menu, ...rodapeLinks].map((item) => (
                <li>
                  <a href={url(item.href)} class="opacity-85 hover:opacity-100 hover:underline">
                    {item.rotulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="text-sm">
          <p class="font-semibold uppercase tracking-widest opacity-60">Contato</p>
          <p class="mt-3 opacity-85">{site.cidade}</p>
          <p class="mt-1 opacity-85">{site.horario}</p>
          <p class="mt-1 opacity-85">WhatsApp e e-mail a confirmar</p>
        </div>
      </div>
      <div class="border-t border-white/10 px-4 py-5 text-center text-xs opacity-70">
        Prévia criada pela <a href="https://casadigitalrp.com.br/" class="underline">CasaDigitalRP</a>. Conteúdo
        ilustrativo, sujeito à aprovação.
      </div>
    </footer>

    <a
      href={whatsappLink()}
      class="fixed right-4 bottom-4 z-40 flex items-center gap-2 rounded-full bg-[#1f8f4e] px-4 py-3 font-semibold text-white shadow-lg hover:brightness-110"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"
        ></path>
      </svg>
      <span class="hidden sm:inline">Fale com a TN</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>

    <script is:inline>
      const alvos = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (es) =>
            es.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visivel");
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.1 },
        );
        alvos.forEach((a) => io.observe(a));
      } else {
        alvos.forEach((a) => a.classList.add("visivel"));
      }
      // Fecha o menu do celular ao apertar Esc
      const menuMovel = document.getElementById("menu-movel");
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menuMovel?.open) {
          menuMovel.open = false;
          menuMovel.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
