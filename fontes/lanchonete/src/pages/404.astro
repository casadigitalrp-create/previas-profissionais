---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout titulo="Página não encontrada" descricao="Página não encontrada.">
  <div class="mx-auto max-w-3xl px-4 pt-20 text-center">
    <h1 class="text-5xl font-extrabold">Esse lanche acabou.</h1>
    <p class="mt-3 text-lg text-suave">A página não existe ou mudou de lugar.</p>
    <a href={base} class="mt-8 inline-block rounded-full bg-ketchup px-6 py-3 font-semibold text-ketchup-texto">Voltar ao início</a>
  </div>
</Layout>
