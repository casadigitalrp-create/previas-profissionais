---
import "../styles/global.css";
import { loja } from "../data/config";

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const atual = Astro.url.pathname;
const menu = [
  { href: base, rotulo: "Início" },
  { href: `${base}cardapio/`, rotulo: "Cardápio" },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${titulo} | ${loja.nome} (modelo)`}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#c8261b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-ketchup focus:px-4 focus:py-2 focus:font-semibold focus:text-ketchup-texto"
      >Pular para o conteúdo</a
    >
    <div class="bg-escuro px-4 py-2 text-center text-sm text-escuro-texto" role="note">
      Modelo demonstrativo da CasaDigitalRP. Marca, cardápio e preços são fictícios e nenhum pedido é enviado.
    </div>

    <header class="sticky top-0 z-40 border-b border-borda bg-fundo/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
        <a href={base} class="flex items-center gap-2 font-display text-lg font-extrabold whitespace-nowrap sm:text-xl">
          <span class="grid size-9 place-items-center rounded-full bg-ketchup text-lg text-ketchup-texto" aria-hidden="true">
            LB
          </span>
          <span>{loja.nome}</span>
        </a>
        <nav aria-label="Principal" class="flex items-center gap-1">
          {
            menu.map((m) => (
              <a
                href={m.href}
                aria-current={atual === m.href ? "page" : undefined}
                class="hidden rounded-md px-3 py-2 font-medium text-suave hover:text-texto aria-[current=page]:text-ketchup sm:block"
              >
                {m.rotulo}
              </a>
            ))
          }
          <a
            href={`${base}pedido/`}
            class="relative ml-1 flex items-center gap-2 rounded-full bg-ketchup px-4 py-2 font-semibold text-ketchup-texto hover:brightness-110"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"></path>
              <circle cx="10" cy="20" r="1.4"></circle>
              <circle cx="17" cy="20" r="1.4"></circle>
            </svg>
            <span class="hidden sm:inline">Sacola</span>
            <span data-contador class="grid min-w-6 place-items-center rounded-full bg-mostarda px-1.5 text-sm text-escuro">0</span>
            <span class="sr-only">itens na sacola</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="conteudo" class="flex-1"><slot /></main>

    <footer class="mt-20 bg-escuro text-escuro-texto">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-xl font-extrabold">{loja.nome}</p>
          <p class="mt-2 text-sm opacity-80">{loja.slogan}</p>
        </div>
        <div class="text-sm opacity-85">
          <p class="font-semibold">Endereço</p>
          <p>{loja.endereco}</p>
          <p>{loja.cidade}</p>
        </div>
        <div class="text-sm opacity-85">
          <p class="font-semibold">Funcionamento</p>
          <p>Terça a domingo, a partir das 18h</p>
          <a href={`${base}politica-de-privacidade/`} class="mt-2 inline-block underline">Política de privacidade</a>
        </div>
      </div>
      <p class="border-t border-white/10 px-4 py-4 text-center text-xs opacity-70">
        Modelo criado pela <a href="https://casadigitalrp.com.br/" class="underline">CasaDigitalRP</a>.
      </p>
    </footer>

    <div
      id="aviso"
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed inset-x-0 bottom-5 z-50 mx-auto w-fit max-w-[90vw] translate-y-24 rounded-full bg-escuro px-5 py-3 font-semibold text-escuro-texto opacity-0 shadow-xl transition"
    >
    </div>

    <script>
      import { totalItens } from "../lib/carrinho";

      const atualizar = () => {
        for (const el of document.querySelectorAll("[data-contador]")) el.textContent = String(totalItens());
      };
      atualizar();
      document.addEventListener("carrinho", atualizar);
    </script>
  </body>
</html>
