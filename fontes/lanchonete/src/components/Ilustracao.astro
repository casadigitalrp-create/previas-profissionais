---
// Ilustrações provisórias: na versão final, fotos reais dos produtos.
import type { Desenho } from "../data/cardapio";

interface Props {
  desenho: Desenho;
  class?: string;
}

const { desenho, class: classe = "" } = Astro.props;
const pao = "#e9a23b";
const paoEscuro = "#c97f1f";
const carne = "#6b3a22";
const queijo = "#f6c22b";
const alface = "#6fb44a";
const tomate = "#d9412f";
---

<svg viewBox="0 0 200 160" class={`h-auto w-full ${classe}`} aria-hidden="true">
  <rect width="200" height="160" class="fill-superficie-2"></rect>
  <ellipse cx="100" cy="138" rx="70" ry="8" fill="#000" opacity=".12"></ellipse>
  {
    (desenho === "burger" || desenho === "duplo" || desenho === "frango") && (
      <g>
        <path d="M44 112h112a10 10 0 0 1-10 14H54a10 10 0 0 1-10-14Z" fill={paoEscuro} />
        {desenho === "duplo" && <rect x="40" y="100" width="120" height="13" rx="6" fill={carne} />}
        <rect x="40" y={desenho === "duplo" ? 86 : 96} width="120" height="15" rx="7" fill={desenho === "frango" ? "#d38a32" : carne} />
        <path d={`M40 ${desenho === "duplo" ? 86 : 96}h120l-8 10-10-6-10 8-12-8-12 9-12-9-12 8-12-8-10 7-10-6Z`} fill={queijo} />
        {desenho !== "duplo" && <rect x="48" y="88" width="104" height="8" rx="4" fill={tomate} />}
        <path d={`M36 ${desenho === "duplo" ? 82 : 86}c8 6 14-4 22 2s14-6 22 0 14-6 22 0 14-6 22 0 14-6 22 0l4 4H34Z`} fill={alface} />
        <path d={`M40 ${desenho === "duplo" ? 80 : 84}c0-30 26-44 60-44s60 14 60 44Z`} fill={pao} />
        <g fill="#fff3d6">
          <ellipse cx="80" cy="56" rx="4" ry="2" />
          <ellipse cx="100" cy="50" rx="4" ry="2" />
          <ellipse cx="120" cy="58" rx="4" ry="2" />
          <ellipse cx="96" cy="66" rx="4" ry="2" />
        </g>
      </g>
    )
  }
  {
    desenho === "hotdog" && (
      <g>
        <path d="M30 96c0 24 140 24 140 0l-6-6H36Z" fill={paoEscuro} />
        <rect x="24" y="78" width="152" height="20" rx="10" fill="#b8452a" />
        <path d="M34 82c10 6 16-6 26 0s16-6 26 0 16-6 26 0 16-6 26 0 16-6 26 0" stroke={queijo} stroke-width="5" fill="none" stroke-linecap="round" />
        <path d="M30 80c0-18 140-18 140 0" fill={pao} />
      </g>
    )
  }
  {
    desenho === "batata" && (
      <g>
        <g fill="#f6c22b" stroke="#d99a12" stroke-width="2">
          <rect x="66" y="30" width="12" height="70" rx="3" transform="rotate(-10 72 65)" />
          <rect x="86" y="22" width="12" height="78" rx="3" />
          <rect x="104" y="26" width="12" height="74" rx="3" transform="rotate(6 110 63)" />
          <rect x="122" y="34" width="12" height="66" rx="3" transform="rotate(14 128 67)" />
        </g>
        <path d="M58 74h84l-10 60H68Z" fill="var(--ketchup)" />
        <path d="M86 98a14 14 0 0 0 28 0" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" />
      </g>
    )
  }
  {
    desenho === "bebida" && (
      <g>
        <rect x="112" y="18" width="6" height="40" rx="3" fill="var(--ketchup)" transform="rotate(12 115 38)" />
        <path d="M70 42h60l-8 92H78Z" fill="var(--ketchup)" />
        <path d="M74 70h52l-2 26H76Z" fill="#fff" opacity=".9" />
        <rect x="66" y="36" width="68" height="10" rx="5" fill="#fff" />
      </g>
    )
  }
  {
    desenho === "milkshake" && (
      <g>
        <rect x="108" y="10" width="6" height="40" rx="3" fill={tomate} transform="rotate(10 111 30)" />
        <path d="M72 46c0-16 56-16 56 0Z" fill="#fff6ee" />
        <circle cx="100" cy="30" r="6" fill={tomate} />
        <path d="M70 46h60l-10 88H80Z" fill="#8a4b2d" />
        <path d="M74 62h52" stroke="#fff6ee" stroke-width="6" />
      </g>
    )
  }
  {
    desenho === "doce" && (
      <g>
        <rect x="52" y="78" width="96" height="50" rx="8" fill="#4a2618" />
        <path d="M60 82h80" stroke="#6b3a22" stroke-width="4" />
        <circle cx="100" cy="66" r="24" fill="#fff6e4" />
        <path d="M80 70c6 8 14 6 20 0s14-8 20 0" stroke="#4a2618" stroke-width="4" fill="none" stroke-linecap="round" />
      </g>
    )
  }
</svg>
